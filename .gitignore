# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# git worktrees (isolated branch workspaces, must never be committed)
.worktrees/

# macOS
.DS_Store
*.pem

# IDE
.idea/
.vscode/

# local env files
.env
.env*.local

# electron-builder output
electron-dist/

# typescript
*.tsbuildinfo

# generated native folders
/android

# iOS - ignore generated files but keep custom native modules
/ios/*
!/ios/Scarletfire/
/ios/Scarletfire/*
!/ios/Scarletfire/AudioPlayerModule.swift
!/ios/Scarletfire/AudioPlayerModule.m
*.swp
*.swo
*~
figma/
deadcast_transcripts/
play-store-credentials.json
.vercel

# Source PDFs for the data-generation scripts — hundreds of MB, kept locally only.
reference_files/*.pdf

# test coverage
coverage/

# Playwright MCP session artifacts (screenshots, console logs, snapshots)
.playwright-mcp/

# Supabase CLI scratch state
supabase/.temp/

# Screenshots and screen recordings dropped at the repo root while working on
# the UI. Anchored to the root so real artwork under assets/ still commits.
/*.png
/*.jpg
/*.jpeg
/*.mov
